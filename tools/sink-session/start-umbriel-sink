#!/bin/sh
# Separate native login for the local Sink fork. The installed official
# start-umbriel launcher and umbriel.service remain untouched.

sink_binary="$HOME/.local/libexec/umbriel-sink/umbriel-sink"
if [ ! -x "$sink_binary" ]; then
  echo "Umbriel Sink binary is missing: $sink_binary" >&2
  exit 1
fi

drs=
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
  drs=dbus-run-session
fi

login_reentry=false
if [ "${UMBRIEL_SINK_LOGIN_REENTRY:-}" = 1 ]; then
  login_reentry=true
  unset UMBRIEL_SINK_LOGIN_REENTRY
  unset WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY UMBRIEL_SOCKET \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
fi

if [ "$login_reentry" = false ]; then
  if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${WAYLAND_SOCKET:-}" ] || [ -n "${DISPLAY:-}" ]; then
    echo "Umbriel Sink must be selected from the login screen, not started inside a running desktop." >&2
    exit 1
  fi

  login_shell_kind=
  if [ -n "${SHELL:-}" ] && [ -x "$SHELL" ] && [ -r /etc/shells ]; then
    case "${SHELL##*/}" in
      fish) login_shell_kind=fish ;;
      ash | bash | dash | ksh | ksh93 | mksh | oksh | sh | yash | zsh)
        login_shell_kind=bourne ;;
    esac
    if [ -n "$login_shell_kind" ]; then
      shell_listed=false
      while IFS= read -r candidate; do
        if [ "$candidate" = "$SHELL" ]; then
          shell_listed=true
          break
        fi
      done < /etc/shells
      if [ "$shell_listed" = false ]; then
        login_shell_kind=
      fi
    fi
  fi

  case "$login_shell_kind" in
    fish)
      UMBRIEL_SINK_LOGIN_REENTRY=1 exec "$SHELL" -l -c 'exec $argv' "$0" "$@"
      ;;
    bourne)
      UMBRIEL_SINK_LOGIN_REENTRY=1 exec "$SHELL" -l -c 'exec "$@"' "$SHELL" "$0" "$@"
      ;;
  esac
fi

if ! command -v systemctl >/dev/null 2>&1 ||
  ! systemctl --user show-environment >/dev/null 2>&1; then
  exec ${drs} "$sink_binary" "$@"
fi

if systemctl --user --quiet is-active umbriel.service ||
  systemctl --user --quiet is-active umbriel-sink.service; then
  echo "An Umbriel session is already running." >&2
  exit 1
fi

systemctl --user reset-failed umbriel-sink.service
systemctl --user unset-environment WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY \
  XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE UMBRIEL_SOCKET
awk 'BEGIN {
  for (name in ENVIRON) {
    if (name != "AWKPATH" && name != "AWKLIBPATH" &&
        name ~ /^[A-Za-z_][A-Za-z0-9_]*$/)
      print name
  }
}' </dev/null | xargs -r systemctl --user import-environment
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --all
fi

systemctl --user --wait start umbriel-sink.service
umbriel_status=$?

systemctl --user start --job-mode=replace-irreversibly umbriel-shutdown.target
systemctl --user unset-environment WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY \
  XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE UMBRIEL_SOCKET

exit "$umbriel_status"
